{{! login.hbs }}

{{#> base}}
  <div class="content">
    <h1>Confirm Your Email Address</h1>
    <p>Hello {{email}},</p>
    <p>Thank you for registering. Please confirm your email address by entering the OTP:</p>
    <h2><strong>{{otp}}</strong></h2>
    <p>If you didn't create an account with us, you can safely ignore this email.</p>
  </div>
{{/base}}